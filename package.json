{
  "name": "smilecare-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w smilecare-server\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "npm run dev -w smilecare-server",
    "build": "tsc -b && vite build && npm run build -w smilecare-server",
    "build:vercel": "tsc -b && vite build --mode demo",
    "deploy:vercel": "vercel --prod --yes",
    "typecheck": "tsc -b --pretty false && npm run typecheck -w smilecare-server",
    "lint": "oxlint",
    "test": "npm run test -w smilecare-server",
    "verify": "powershell -NoProfile -File scripts/verify.ps1",
    "setup:test-env": "powershell -NoProfile -File scripts/setup-test-env.ps1",
    "preview": "vite preview",
    "seed:demo": "npm run seed:demo -w smilecare-server",
    "start": "npm run start -w smilecare-server"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.1",
    "concurrently": "^9.2.1",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vercel": "^65.15.0",
    "vite": "^8.1.0",
    "vitest": "^3.2.4"
  }
}
